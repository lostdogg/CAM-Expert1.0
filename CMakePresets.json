{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 – Visual Studio 18 2026",
      "description": "Configure for Visual Studio 2026 (toolset v180) on 64-bit Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 – Visual Studio 17 2022",
      "description": "Configure for Visual Studio 2022 (toolset v143) on 64-bit Windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2019",
      "displayName": "Windows x64 – Visual Studio 16 2019",
      "description": "Configure for Visual Studio 2019 (toolset v142) on 64-bit Windows",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows – MinGW Makefiles (Release)",
      "description": "Configure for MinGW-w64 / Clang on Windows",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release-vs2026",
      "displayName": "Release (VS 2026)",
      "configurePreset": "windows-vs2026",
      "configuration": "Release"
    },
    {
      "name": "release-vs2022",
      "displayName": "Release (VS 2022)",
      "configurePreset": "windows-vs2022",
      "configuration": "Release"
    },
    {
      "name": "release-vs2019",
      "displayName": "Release (VS 2019)",
      "configurePreset": "windows-vs2019",
      "configuration": "Release"
    },
    {
      "name": "release-mingw",
      "displayName": "Release (MinGW)",
      "configurePreset": "windows-mingw-release"
    }
  ]
}
